---
import { reviews } from '../content/site';
---

<section id="reviews" class="section bg-white">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="eyebrow">Reviews</p>
      <h2 class="h2 mt-2">{reviews.heading}</h2>
      <p class="lede mt-4">{reviews.intro}</p>
    </div>

    <!-- TODO: replace with real, permission-given reviews -->
    <div class="mt-12 grid gap-6 sm:mt-16 lg:grid-cols-3">
      {
        reviews.items.map((item) => (
          <div class="card card-hover flex flex-col p-8 sm:p-10" data-reveal>
            <div class="flex items-center gap-1" role="img" aria-label={`${item.rating} out of 5 stars`}>
              {Array.from({ length: 5 }).map((_, i) => (
                <svg
                  class={`h-5 w-5 ${i < item.rating ? 'text-gold-400' : 'text-navy-100'}`}
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.2 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.7l6.1-.6L10 1.5Z" />
                </svg>
              ))}
            </div>

            <blockquote class="mt-5 flex-1 text-base leading-relaxed text-ink">
              “{item.quote}”
            </blockquote>

            <footer class="mt-6 border-t border-navy-100 pt-4">
              <p class="font-bold text-ink">{item.author}</p>
              <p class="text-sm text-muted">{item.detail}</p>
            </footer>
          </div>
        ))
      }
    </div>
  </div>
</section>
