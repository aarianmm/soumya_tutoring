---
import { finalCta } from '../content/site';
---

<section class="relative overflow-hidden bg-navy-900">
  <div class="pointer-events-none absolute -left-24 -top-24 h-72 w-72 rounded-full bg-navy-700/40 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -bottom-28 -right-16 h-80 w-80 rounded-full bg-gold-400/10 blur-3xl" aria-hidden="true"></div>

  <div class="container-page section relative">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{finalCta.heading}</h2>
      <p class="mt-4 text-base leading-relaxed text-navy-100 sm:text-lg">{finalCta.body}</p>

      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={finalCta.primaryCta.href} class="btn-accent w-full sm:w-auto">
          {finalCta.primaryCta.label}
        </a>
        <a
          href={finalCta.secondaryCta.href}
          class="btn w-full border border-white/70 text-white hover:bg-white/10 focus-visible:outline-white sm:w-auto"
        >
          {finalCta.secondaryCta.label}
        </a>
      </div>
    </div>
  </div>
</section>
