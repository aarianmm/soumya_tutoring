---
import Icon from './Icon.astro';
import { pricing } from '../content/site';
---

<section id="prices" class="section bg-cream">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="eyebrow">Prices</p>
      <h2 class="h2 mt-2">{pricing.heading}</h2>
      <p class="lede mt-4">{pricing.intro}</p>
    </div>

    <div class="mt-12 grid gap-6 sm:mt-16 lg:grid-cols-3">
      {
        pricing.tiers.map((tier) => (
          <div
            class:list={[
              'relative flex flex-col p-8 sm:p-10',
              tier.featured
                ? 'card rounded-[var(--radius-card)] border-2 border-navy-500 shadow-[var(--shadow-lift)] lg:-translate-y-3'
                : 'card card-hover',
            ]}
            data-reveal
          >
            {tier.featured && (
              <span class="pill absolute -top-3.5 left-1/2 -translate-x-1/2 bg-gold-400 text-navy-900 shadow-sm">
                Most popular
              </span>
            )}

            <h3 class="text-xl font-bold text-ink">{tier.name}</h3>

            <p class="mt-5 flex items-baseline gap-1.5">
              <span class="text-4xl font-bold tracking-tight text-ink">{tier.price}</span>
              <span class="text-sm font-medium text-muted">{tier.unit}</span>
            </p>
            <p class="mt-1 text-sm text-muted">{tier.note}</p>

            <ul class="mt-6 flex-1 space-y-3">
              {tier.features.map((feature) => (
                <li class="flex items-start gap-2.5 text-sm text-ink">
                  <Icon name="check" class="mt-0.5 h-5 w-5 flex-shrink-0 text-navy-500" />
                  <span>{feature}</span>
                </li>
              ))}
            </ul>

            <a
              href="#contact"
              class={tier.featured ? 'btn-primary mt-8 w-full' : 'btn-ghost mt-8 w-full'}
            >
              Book a Session
            </a>
          </div>
        ))
      }
    </div>

    <div
      class="mt-8 rounded-[var(--radius-card)] bg-navy-800 p-8 text-white shadow-[var(--shadow-lift)] sm:p-10 lg:flex lg:items-center lg:justify-between lg:gap-10"
      data-reveal
    >
      <div class="max-w-xl">
        <h3 class="text-2xl font-bold text-white">{pricing.package.heading}</h3>
        <p class="mt-3 leading-relaxed text-navy-100">{pricing.package.body}</p>
      </div>

      <div class="mt-8 flex flex-col gap-6 sm:flex-row sm:items-center lg:mt-0 lg:flex-shrink-0">
        <div class="flex items-center gap-6">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-navy-300">
              {pricing.package.single.label}
            </p>
            <p class="mt-1 text-lg font-semibold text-navy-300 line-through decoration-2">
              {pricing.package.single.value}
            </p>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-navy-200">
              {pricing.package.bundle.label}
            </p>
            <p class="mt-1 text-3xl font-bold text-white">{pricing.package.bundle.value}</p>
          </div>
          <span class="pill bg-gold-400 text-navy-900">{pricing.package.saving}</span>
        </div>
        <a href="#contact" class="btn-accent flex-shrink-0">Book a Session</a>
      </div>
    </div>

    <p class="mt-4 text-center text-sm text-muted">All prices are per 60-minute session.</p>
  </div>
</section>
